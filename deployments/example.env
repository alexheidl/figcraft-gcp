# An example deployment. Copy it to deployments/<name>.env (git ignores those) or into a folder of
# your own that FIGCRAFT_DEPLOYMENTS points at, and fill in your values.
# Read by bin/setup, bin/figcraft-connect, bin/install-launcher and bin/team-list.

# Where it runs. Use one GCP project per deployment: tunnel access is granted on the whole project
# (limited to FigCraft's port), and the network, firewall and snapshot names are the same in every
# deployment. The project needs its `default` VPC network.
PROJECT=my-figcraft-project
REGION=europe-west3
ZONE=europe-west3-a
VM=figcraft
MACHINE_TYPE=e2-small

# Who gets in: Google accounts, separated by spaces. Everyone here sees and edits every file on the
# team list. ADMIN also gets SSH to the VM.
MEMBERS="ada@example.com grace@example.com"
ADMIN=ada@example.com

# Secret Manager secret that will hold the server key (the output of `figcraft-server key`).
SECRET=figcraft-server-key

# Must match the FigCraft desktop app everyone uses.
FIGCRAFT_VERSION=0.17.0

# The port on each person's machine where the tunnel arrives. Share links name it, so everyone in a
# deployment must use the same one. Give each deployment its own if you use several at once.
LOCAL_PORT=47900
